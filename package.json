{
  "name": "daily-baker",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "docker start daily-baker-local-postgres 2>/dev/null || docker compose -f docker-compose.local.yml up -d && npm run db:wait && next dev --port 3030",
    "db:wait": "until docker exec daily-baker-local-postgres pg_isready -U daily_baker_user -d daily_baker > /dev/null 2>&1; do sleep 1; done",
    "dev:lint": "next dev --experimental-lint-on-change",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "type-check": "tsc --noEmit",
    "check": "npm run type-check && npm run lint",
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:reset": "prisma migrate reset",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1146.0",
    "@aws-sdk/client-ses": "^3.1146.0",
    "@aws-sdk/s3-request-presigner": "^3.1146.0",
    "@clerk/nextjs": "^6.39.7",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@mdxeditor/editor": "^3.55.0",
    "@prisma/client": "^6.19.3",
    "@sentry/nextjs": "^10.76.0",
    "@tanstack/react-query": "^5.104.1",
    "@vercel/toolbar": "^0.2.7",
    "bcryptjs": "^3.0.3",
    "cheerio": "^1.2.0",
    "convert-units": "^2.3.4",
    "daisyui": "^5.7.47",
    "date-fns": "^4.4.0",
    "dotenv": "^17.4.2",
    "lucide-react": "^0.577.0",
    "nanoid": "^5.1.16",
    "next": "^16.3.8",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "swagger-ui-react": "^5.33.1",
    "zod": "4.1.12",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/bcryptjs": "^2.4.6",
    "@types/cheerio": "^1.0.0",
    "@types/convert-units": "^2.3.12",
    "@types/node": "^20",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/swagger-ui-react": "^5.18.0",
    "baseline-browser-mapping": "^2.11.27",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.8",
    "lightningcss": "^1.33.0",
    "prisma": "^6.19.3",
    "tailwindcss": "^4.3.3",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  },
  "packageManager": "pnpm@10.13.1+sha512.37ebf1a5c7a30d5fabe0c5df44ee8da4c965ca0c5af3dbab28c3a1681b70a256218d05c81c9c0dcf767ef6b8551eb5b960042b9ed4300c59242336377e01cfad"
}
